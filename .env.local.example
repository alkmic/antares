# Antares — variables d'environnement (EXEMPLE)
# Copier vers .env.local et renseigner. .env.local n'est JAMAIS committé (voir .gitignore).

# === Requis dès maintenant (foundation) ===

# Base de données PostgreSQL — Neon (région Frankfurt)
# Format: postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Secret Payload (chiffrement sessions/JWT) — générer avec: openssl rand -hex 32
PAYLOAD_SECRET=

# === Requis plus tard (features) ===

# Emails transactionnels (Resend)
RESEND_API_KEY=

# Analytics (Plausible Cloud + API serveur)
PLAUSIBLE_API_KEY=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=antares-avocats.fr

# Webhook Calendly (signature)
CALENDLY_WEBHOOK_SIGNING_KEY=

# Captcha (Cloudflare Turnstile)
CLOUDFLARE_TURNSTILE_SECRET=

# Secret pour les routes cron (revalidation, digests)
CRON_SECRET=
