{
  "$schema": "https://design-tokens.org/schema.json",
  "_meta": {
    "name": "Antares Design Tokens",
    "version": "2.0.0",
    "date": "2026-05-22",
    "license": "internal · cabinet d'avocats Antares"
  },

  "color": {
    "bone":           { "value": "#F4EFE6", "description": "Surface principale du site public" },
    "bone-warm":      { "value": "#EBE3D4", "description": "Bandes manifesto, fonds tertiaires" },
    "ink":            { "value": "#0B1426", "description": "Texte principal, fond admin/footer, bouton primaire" },
    "ink-soft":       { "value": "#1F2A3D", "description": "Hover bouton ink, texte secondaire" },
    "ink-line":       { "value": "#2A364B", "description": "Séparateurs sur fond ink" },
    "antares":        { "value": "#A23B2E", "description": "Accent unique — italiques d'accent, mark logo, CTA secondaire" },
    "antares-deep":   { "value": "#7A2A21", "description": "Hover sur surface antarès" },
    "antares-glow":   { "value": "#C45446", "description": "Tooltips danger, actions destructives" },
    "gold":           { "value": "#B8915C", "description": "Réservé aux fonds ink — labels footer, italiques sur dark" },
    "muted":          { "value": "#5E6573", "description": "Métadonnées mono, légendes, placeholder" },
    "card":           { "value": "#FFFFFF", "description": "Surface cartes admin et inputs — jamais sur site public" },

    "success":        { "value": "#2D6A4F", "description": "Confirmations, tag visio, deltas positifs" },
    "warning":        { "value": "#B8841A", "description": "Tag cabinet, candidatures en relecture, retards" },

    "line":           { "value": "rgba(11, 20, 38, 0.10)", "description": "Filets, bordures cartes" },
    "line-strong":    { "value": "rgba(11, 20, 38, 0.25)", "description": "Bordures inputs, séparations actives" }
  },

  "fontFamily": {
    "display":        { "value": "Fraunces, Georgia, serif", "description": "Display + titres serif" },
    "italic":         { "value": "'Instrument Serif', Georgia, serif", "description": "Italiques d'accent UNIQUEMENT" },
    "body":           { "value": "Manrope, Arial, sans-serif", "description": "Corps + UI" },
    "mono":           { "value": "'JetBrains Mono', monospace", "description": "Mono — labels, métadonnées, numérotation ⌗" }
  },

  "fontSize": {
    "display-1":      { "value": "96px",  "lineHeight": "0.95", "letterSpacing": "-0.035em", "weight": 300, "family": "display" },
    "display-2":      { "value": "64px",  "lineHeight": "1.02", "letterSpacing": "-0.025em", "weight": 300, "family": "display" },
    "h1":             { "value": "44px",  "lineHeight": "1.10", "letterSpacing": "-0.020em", "weight": 400, "family": "display" },
    "h2":             { "value": "28px",  "lineHeight": "1.20", "letterSpacing": "-0.015em", "weight": 400, "family": "display" },
    "h3":             { "value": "20px",  "lineHeight": "1.25", "letterSpacing": "0",        "weight": 500, "family": "display" },
    "italic-accent":  { "value": "44px",  "lineHeight": "1.10", "letterSpacing": "0",        "weight": 400, "family": "italic", "color": "antares" },
    "body":           { "value": "15px",  "lineHeight": "1.55", "letterSpacing": "-0.005em", "weight": 400, "family": "body" },
    "small":          { "value": "13px",  "lineHeight": "1.40", "letterSpacing": "0",        "weight": 500, "family": "body" },
    "mono-label":     { "value": "11px",  "lineHeight": "1.40", "letterSpacing": "0.180em",  "weight": 400, "family": "mono",   "textTransform": "uppercase" }
  },

  "spacing": {
    "s-1":  { "value": "4px" },
    "s-2":  { "value": "8px" },
    "s-3":  { "value": "12px" },
    "s-4":  { "value": "16px" },
    "s-5":  { "value": "24px" },
    "s-6":  { "value": "32px" },
    "s-7":  { "value": "48px" },
    "s-8":  { "value": "64px" },
    "s-9":  { "value": "80px" },
    "s-10": { "value": "120px" },
    "s-11": { "value": "160px" }
  },

  "radius": {
    "r-0":    { "value": "0",    "description": "Site public — arêtes franches" },
    "r-1":    { "value": "4px",  "description": "Pills, mini-badges" },
    "r-2":    { "value": "6px",  "description": "Inputs admin, boutons admin" },
    "r-3":    { "value": "8px",  "description": "Cartes admin" },
    "r-full": { "value": "9999px", "description": "Avatars, pastilles" }
  },

  "shadow": {
    "e-0": { "value": "none", "description": "Flat — site public (filet --line uniquement)" },
    "e-1": { "value": "0 1px 2px rgba(11, 20, 38, 0.06)", "description": "Tabs actifs, cartes admin par défaut" },
    "e-2": { "value": "0 2px 8px rgba(11, 20, 38, 0.08), 0 1px 2px rgba(11, 20, 38, 0.04)", "description": "Emails, popovers" },
    "e-3": { "value": "0 12px 28px rgba(11, 20, 38, 0.14), 0 4px 8px rgba(11, 20, 38, 0.06)", "description": "Bannière cookies, modales, tooltips persistants" }
  },

  "breakpoint": {
    "mobile":  { "value": "380px",  "description": "iPhone SE / petit Android" },
    "tablet":  { "value": "768px",  "description": "iPad portrait" },
    "desktop": { "value": "1100px", "description": "Laptop · breakpoint principal" },
    "wide":    { "value": "1440px", "description": "Container max" }
  },

  "grid": {
    "columns": {
      "mobile":  { "value": 4,  "gutter": "16px", "margin": "24px" },
      "desktop": { "value": 12, "gutter": "32px", "margin": "56px" }
    },
    "container": { "maxWidth": "1440px" }
  },

  "motion": {
    "transition-fast":   { "value": "0.12s ease" },
    "transition-base":   { "value": "0.15s ease" },
    "transition-medium": { "value": "0.20s ease" },
    "transition-slow":   { "value": "0.30s ease" }
  },

  "grain": {
    "opacity": { "value": 0.04 },
    "blend":   { "value": "multiply" },
    "zIndex":  { "value": 200 },
    "_note":   "feTurbulence SVG fixed position pointer-events:none. Voir generate-grain.svg dans /public."
  }
}
